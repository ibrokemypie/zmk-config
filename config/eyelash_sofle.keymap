#include <behaviors.dtsi>

#include "zmk-helpers/helper.h"
#include "zmk-helpers/key-labels/sofle.h"

#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/rgb.h>

#define BASE 0
#define RAISE 1
#define LOWER 2
#define ADJUST 3


/* Homerow mods */

#define KEYS_L LT0 LT1 LT2 LT3 LT4 LT5 LM0 LM1 LM2 LM3 LM4 LM5 LB0 LB1 LB2 LB3 LB4 LB5  // Left-hand keys.
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RT5 RM0 RM1 RM2 RM3 RM4 RM5 RB0 RB1 RB2 RB3 RB4 RB5  // Right-hand keys.
#define THUMBS LH4 LH3 LH2 LH1 LH0 RH0 RH1 RH2 RH3 RH4                                  // Thumb keys.

/* Left-hand HRMs. */
ZMK_HOLD_TAP(hml,
    flavor = "balanced";
    tapping-term-ms = <280>;
    quick-tap-ms = <175>;
    require-prior-idle-ms = <100>;
    bindings = <&kp>, <&kp>;
    hold-trigger-key-positions = <KEYS_R THUMBS>;
    hold-trigger-on-release;
)

/* Right-hand HRMs. */
ZMK_HOLD_TAP(hmr,
    flavor = "balanced";
    tapping-term-ms = <280>;
    quick-tap-ms = <175>;
    require-prior-idle-ms = <100>;
    bindings = <&kp>, <&kp>;
    hold-trigger-key-positions = <KEYS_L THUMBS>;
    hold-trigger-on-release;
)

/* mouse emulation */

#include "mouse.dtsi"

/* adjust */
ZMK_CONDITIONAL_LAYER(adjust, RAISE LOWER, ADJUST)

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };


    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&kp GRAVE       &kp N1        &kp N2      &kp N3       &kp N4        &kp N5    &kp UP       &kp N6    &kp N7        &kp N8       &kp N9      &kp N0         &kp MINUS
&kp TAB         &kp Q         &kp W       &kp E        &kp R         &kp T     &kp DOWN     &kp Y     &kp U         &kp I        &kp O       &kp P          &kp BACKSPACE
&lt RAISE ESC   &hml LGUI A   &hml LALT S &hml LCTRL D &hml LSHIFT F &kp G     &kp LEFT     &kp H     &hmr RSHIFT J &hmr RCTRL K &hmr RALT L &hmr RGUI SEMI &kp APOS
&kp BACKSPACE   &kp Z         &kp X       &kp C        &kp V         &kp B     &kp RIGHT    &kp N     &kp M         &kp COMMA    &kp DOT     &kp FSLH       &kp PIPE
&kp C_MUTE      &kp BACKSPACE &kp ENTER   &mo LOWER    &kp LSHIFT    &kp SPACE &kp ENTER    &kp ENTER &kp RSHIFT    &mo RAISE    &kp SPACE   &kp BACKSPACE 
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

            
        raise {
            bindings = <
&trans      &kp F1 &kp F2    &kp F3    &kp F4    &kp F5    &trans &kp F6        &kp F7    &kp F8 &kp F9    &kp F10 &kp F11
&kp LC(TAB) &trans &kp LC(W) &kp LC(E) &kp LC(R) &kp LC(T) &trans &kp F12       &kp LC(U) &trans &kp LC(O) &trans  &kp DELETE
&trans      &trans &trans    &kp LC(D) &trans    &trans    &trans &kp LEFT      &kp DOWN  &kp UP &kp RIGHT &trans  &kp LC(RIGHT_BRACKET)
&trans      &trans &trans    &trans    &trans    &trans    &trans &trans        &trans    &trans &trans    &trans  &trans
&trans      &trans &trans    &mo RAISE &trans    &trans    &trans &kp LC(ENTER) &trans    &trans &trans    &trans
 >;

 display-name = "raise";
 sensor-bindings = <&scroll_encoder>;
 };
 
 lower {
 bindings = <
&trans     &kp F1 &kp F2    &kp F3    &kp F4    &kp F5   &mmv MOVE_UP    &kp F6          &kp F7   &kp F8      &kp F9        &kp F10          &kp F11
&trans     &trans &mkp LCLK &mkp MCLK &mkp RCLK &mkp MB4 &mmv MOVE_DOWN  &kp F12         &trans   &kp PAGE_UP &kp PAGE_DOWN &kp PLUS         &kp DELETE
&trans     &trans &trans    &trans    &trans    &mkp MB5 &mmv MOVE_LEFT  &kp LEFT        &kp DOWN &kp UP      &kp RIGHT     &kp LEFT_BRACKET &kp RIGHT_BRACKET
&trans     &trans &trans    &trans    &trans    &trans   &mmv MOVE_RIGHT &trans          &trans   &trans      &trans        &trans           &trans
&kp C_MUTE &trans &trans    &trans    &trans    &trans   &mkp LCLK       &kp LC(ENTER)   &trans   &mo ADJUST  &trans        &kp DELETE
 >;

 display-name = "lower";
 sensor-bindings = <&scroll_encoder>;
 };

 adjust {
 bindings = <
&trans         &bt BT_SEL 0    &bt BT_SEL 1   &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4    &trans &trans          &trans          &trans &trans &trans &trans
&out OUT_BLE   &bt BT_CLR      &bt BT_CLR_ALL &trans          &trans          &trans          &trans &trans          &trans          &trans &trans &trans &trans
&out OUT_USB   &trans          &trans         &trans          &trans          &trans          &trans &trans          &trans          &trans &trans &trans &trans
&trans         &rgb_ug RGB_OFF &rgb_ug RGB_ON &rgb_ug RGB_EFF &rgb_ug RGB_EFR &rgb_ug RGB_SPI &trans &rgb_ug RGB_BRI &rgb_ug RGB_BRD &trans &trans &trans &trans
&sys_reset     &trans          &trans         &trans          &trans          &trans          &trans &trans          &trans          &trans &trans &trans
            >;

            display-name = "adjust";
            sensor-bindings = <&scroll_encoder>;
        };
    };
};
